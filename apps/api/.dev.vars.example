# Copy to .dev.vars (gitignored) for `wrangler dev`. Tests pin their own value in vitest.config.ts.
# `pnpm dev` runs `wrangler dev --env dev`, which reads .dev.vars.dev when it exists and falls back to this file.
# OWNER_EMAIL is normalized and seeded as the Registry owner (role `owner`) on start.
# Deployed environments set it per environment: `wrangler secret put OWNER_EMAIL --env production` (or --env="" for staging).
OWNER_EMAIL=owner@example.com
# The DownSub API key (transcripts; the catalog's provider health). Optional locally: unset, the
# provider reads as `unreachable` and nothing is called. Deployed: `wrangler secret put DOWNSUB_API_KEY --env <env>`.
# DOWNSUB_API_KEY=
# Optional: browser origins allowed by CORS, overriding vars.WEB_ORIGINS in wrangler.jsonc for local dev.
# WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local-only secrets for `wrangler dev`. Gitignored — never commit this file.
# BETTER_AUTH_SECRET=
# BASE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
