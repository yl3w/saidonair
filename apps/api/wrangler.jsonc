{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "media-digest-api",
  "main": "src/index.ts",
  // Newest date accepted by the workerd bundled with the pinned @cloudflare/vitest-pool-workers.
  // Raise it together with that dependency.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "vars": {
    // Browser origins allowed to call the API (CORS): comma-separated; `scheme://*.host` matches any
    // subdomain, for Pages previews. Not a guard: there is no authentication (docs/PRD.md §2).
    // TODO(owner): add the deployed web origins, e.g. "https://<project>.pages.dev,https://*.<project>.pages.dev".
    "WEB_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },

  // `.sql` migration files are imported as strings (see migrations/registry/index.ts).
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY_DO", "class_name": "RegistryDO" },
      { "name": "USER_DO", "class_name": "UserDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegistryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserDO"] }
  ]

  // Secrets (never `vars`, never committed):
  //   OWNER_EMAIL — seeded as the Registry owner. Local: apps/api/.dev.vars (copy .dev.vars.example).
  //                 Deployed: `wrangler secret put OWNER_EMAIL`.
  // TODO(owner): Add the cron trigger after its cadence and times are decided.
}
