{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Three environments (owner decision 2026-09-13; AGENTS.md → Environments): the top level IS staging, so a bare
  // `wrangler deploy` can never reach production; `pnpm dev` runs `--env dev` against dev-only remote resources;
  // production is `--env production`. Wrangler does not inherit bindings into environments (it does inherit
  // `migrations`, `rules`, and the compatibility settings), so each one repeats its bindings, and
  // test/wrangler-config.test.ts fails when they drift. Per-environment resources follow one naming rule:
  // production `x`, staging `x-staging`, dev `x-dev` (Worker, Vectorize index, Workflow). Cron triggers exist in
  // production only; staging and dev are driven by hand.
  "name": "media-digest-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    // TODO(owner): WEB_ORIGINS for the deployed staging web (the Pages preview origin) once it exists. Unset, CORS
    // allows only the local Vite origins (lib/cors.ts), which is enough to drive staging from a local web.
  },
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    {
      "name": "media-digest-ingest-staging",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestWorkflow"
    }
  ],
  "vectorize": [
    { "binding": "VECTORS", "index_name": "media-rag-staging", "remote": true }
  ],
  // TODO(owner): create with `wrangler d1 create media-digest-auth-staging` and paste its id.
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "media-digest-auth-staging",
      "database_id": "TODO-create-and-paste-the-id"
    }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "REGISTRY_DO", "class_name": "RegistryDO" },
      { "name": "USER_DO", "class_name": "UserDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RegistryDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UserDO"] }
  ],
  "env": {
    "dev": {
      // Local development: `pnpm dev`. Secrets come from .dev.vars.dev, falling back to .dev.vars.
      "name": "media-digest-api-dev",
      "vars": {
        "WEB_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        // `localhost`, not `127.0.0.1`: better-auth builds each provider's redirect_uri from this,
        // and it must match the URI registered with Google and Meta exactly or they refuse the
        // callback. The A0 spike registered `http://localhost:8787/auth/callback/google`.
        "API_BASE_URL": "http://localhost:8787"
      },
      "ai": { "binding": "AI", "remote": true },
      "workflows": [
        {
          "name": "media-digest-ingest-dev",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestWorkflow"
        }
      ],
      "vectorize": [
        { "binding": "VECTORS", "index_name": "media-rag-dev", "remote": true }
      ],
      // Local only: `wrangler dev` keeps this database on disk under .wrangler/state, so the id is
      // a placeholder and nothing is provisioned on Cloudflare (proved by the A0 spike).
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "media-digest-auth-dev",
          "database_id": "local"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "REGISTRY_DO", "class_name": "RegistryDO" },
          { "name": "USER_DO", "class_name": "UserDO" }
        ]
      }
    },
    "production": {
      "name": "media-digest-api",
      "vars": {
        // TODO(owner): WEB_ORIGINS for the production web (the Pages production origin) before the first deploy.
      },
      "ai": { "binding": "AI", "remote": true },
      "workflows": [
        {
          "name": "media-digest-ingest",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestWorkflow"
        }
      ],
      "vectorize": [
        { "binding": "VECTORS", "index_name": "media-rag", "remote": true }
      ],
      // TODO(owner): create with `wrangler d1 create media-digest-auth` and paste its id.
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "media-digest-auth",
          "database_id": "TODO-create-and-paste-the-id"
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "REGISTRY_DO", "class_name": "RegistryDO" },
          { "name": "USER_DO", "class_name": "UserDO" }
        ]
      },
      // The crons live here only (AGENTS.md → Environments): discovery on the hour, recovery at half past,
      // dispatched by expression in lib/ingestion.ts.
      "triggers": { "crons": ["0 */6 * * *", "30 */6 * * *"] }
    }
  }
}
