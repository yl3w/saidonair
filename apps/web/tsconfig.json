{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["vite/client"]
  },
  // `src/server` is the Worker's, and it compiles under tsconfig.worker.json instead: its globals
  // are workerd's, not a browser's (docs/specs/public-reading-plan.md step 1.1).
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/server"]
}
