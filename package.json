{
  "name": "media-digest-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": "22.x",
    "pnpm": "10.29.3"
  },
  "volta": {
    "node": "22.23.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run typecheck lint test",
    "dev": "turbo run dev",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --unsafe .",
    "skills:install": "sh scripts/skills.sh install",
    "skills:remove": "sh scripts/skills.sh remove",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify:vectorize": "sh scripts/verify-vectorize.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  }
}
